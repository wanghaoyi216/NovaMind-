# =====================================================================
# NovaMind 智星云 —— Docker Compose 环境变量模板
# ---------------------------------------------------------------------
# 用法：复制本文件为 .env（docker compose 会自动读取同目录 .env）：
#     cp .env.example .env
# 然后把下面的占位值改为真实值。
#
# 安全约定：
#   1. .env 含真实口令，已被 .gitignore 忽略，严禁提交到仓库；
#   2. 生产环境请全部替换为强口令，不得保留任何示例值；
#   3. 修改 MySQL 口令后，xxl-job 会自动跟随（compose 内以
#      SPRING_DATASOURCE_PASSWORD 注入），但 Nacos 中 shared-*.yaml
#      等业务数据源配置、docker/redis/conf/redis.conf 的 requirepass
#      需要手工同步（详见 docker/README-local.md）。
# =====================================================================

# ---- MySQL（mysql 服务 root 口令；同时注入 xxl-job 数据源） ----
# 用途：MYSQL_ROOT_PASSWORD / healthcheck / xxl-job SPRING_DATASOURCE_PASSWORD
MYSQL_ROOT_PASSWORD=change-me-in-production

# ---- RabbitMQ（消息队列管理账号，控制台 http://localhost:15672） ----
RABBITMQ_DEFAULT_USER=change-me-in-production
RABBITMQ_DEFAULT_PASS=change-me-in-production

# ---- MinIO（对象存储 root 账号，控制台 http://localhost:9001） ----
MINIO_ROOT_USER=change-me-in-production
MINIO_ROOT_PASSWORD=change-me-in-production

# ---- MongoDB（root 账号，novamind-aigc 会话/记忆存储使用） ----
MONGO_INITDB_ROOT_USERNAME=change-me-in-production
MONGO_INITDB_ROOT_PASSWORD=change-me-in-production

# ---- Neo4j（图数据库账号，知识图谱使用，控制台 http://localhost:7474） ----
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-in-production
